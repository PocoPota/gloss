# Translation engine selection: echo | claude | gemini | deepl
GLOSS_ENGINE=echo

# Claude
ANTHROPIC_API_KEY=
GLOSS_CLAUDE_MODEL=claude-sonnet-4-6
# GLOSS_CLAUDE_MAX_WORKERS=4    # in-flight requests cap
# GLOSS_CLAUDE_RPM=0            # 0 = no throttle (paid tier)

# Gemini
GEMINI_API_KEY=
GLOSS_GEMINI_MODEL=gemini-2.5-flash
# GLOSS_GEMINI_MAX_WORKERS=2
# GLOSS_GEMINI_RPM=10           # free tier gemini-2.5-flash is ~10 RPM; raise for paid

# DeepL (optional)
DEEPL_API_KEY=

# Shared fallback (used if per-engine var not set)
# GLOSS_MAX_WORKERS=
# GLOSS_RPM=
